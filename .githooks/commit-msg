#!/bin/sh
# Strip AI attribution trailers from commit messages.
#
# Enable in a fresh clone (git config is not cloned, so this is needed once):
#     git config core.hooksPath .githooks

msg="$1"
[ -f "$msg" ] || exit 0

# grep -c prints a count but exits 1 when the count is zero, so the exit status
# must be ignored rather than substituted for the count.
before=$(grep -ciE '^(co-authored-by:.*(claude|anthropic)|claude-session:|generated with .*claude)' "$msg" 2>/dev/null)
[ -n "$before" ] || before=0

if [ "$before" -gt 0 ]; then
  tmp="$msg.tmp.$$"
  grep -viE '^(co-authored-by:.*(claude|anthropic)|claude-session:|generated with .*claude)' "$msg" > "$tmp"
  # drop any blank lines left dangling at the end
  awk 'BEGIN{n=0} {lines[NR]=$0} END{last=NR; while(last>0 && lines[last]~/^[[:space:]]*$/) last--; for(i=1;i<=last;i++) print lines[i]}' "$tmp" > "$msg"
  rm -f "$tmp"
  echo "commit-msg: removed $before AI attribution line(s)" >&2
fi

exit 0
